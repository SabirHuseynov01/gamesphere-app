# Base URL of the Gamesphere backend API (Spring Boot, default port 8080).
VITE_API_BASE_URL=http://localhost:8080/api

# Backend origin used to resolve uploaded media under /uploads.
VITE_BACKEND_URL=http://localhost:8080

# Display-currency conversion. Prices are stored and charged in the product's
# own currency; this only controls what the AZN switch shows.
VITE_AZN_PER_USD=1.7
